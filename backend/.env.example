# Generate a unique random value for each deployment (for example, python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=replace-with-a-random-secret-before-running

# Configure at least one AI provider.
GEMINI_API_KEY=
GROQ_API_KEY=
PROVIDER_ORDER=gemini,groq
GEMINI_MODEL=gemini-3.8-flash
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_MODEL=openai/gpt-oss-120b
MONTHLY_TRANSCRIPTION_QUOTA=60
TRANSCRIPTION_JOB_TIMEOUT_MINUTES=30
AUDIO_RETENTION_DAYS=30
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=data
# S3-compatible storage (AWS S3, Cloudflare R2, or Supabase Storage S3 endpoint)
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=path
AUDIO_SIGNED_URL_TTL=3600

MAX_AUDIO_BYTES=20971520
MAX_AUDIO_DURATION_SECONDS=7200
RATE_LIMIT_PER_MINUTE=12
DATABASE_URL=sqlite:///data/meetings.sqlite3
CORS_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000
# EMAIL_PROVIDER=console for local development; use smtp or resend in production.
EMAIL_PROVIDER=console
EMAIL_FROM=AI Meeting Secretary <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=
